{
  "expo": {
    "name": "AgriNafa",
    "slug": "agrinafa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "agrinafa",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00693B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bf.agrinafa.app"
    },
    "android": {
      "package": "bf.agrinafa.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-fond.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "AgriNafa utilise le micro pour que vous puissiez dicter vos dépenses au lieu de les écrire."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
